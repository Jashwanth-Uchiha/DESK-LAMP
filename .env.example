# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These values identify your project; they are not secrets, but keep them out of source control
# so each environment (dev / staging / prod) can point at its own project.
# Security comes from database.rules.json, not from hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use the local Auth + Database emulators (npm run dev:emulators).
# When true, the values above may be left blank; a demo project is used.
VITE_USE_EMULATORS=false
